"marketSentiment.descriptions.composite.shortDescription" = "Sentiment Inside Out 恐懼貪婪指標 (簡稱:SIO恐懼貪婪指標) 將市場情緒量化成 0~100 的分數，目的在於了解當前市場參與者的心理是偏向恐懼還是貪婪，類似於 CNN 恐懼貪婪指數和 BofA 牛熊指標。幫助投資人在非理性的股市波動中保持冷靜，避免跟著情緒追高殺低。";
"marketSentiment.descriptions.composite.sections" = "[{'title': '解讀 SIO 恐懼貪婪指標', 'content': 'SIO恐懼貪婪指標是由多個美股市場數據綜合計算而成的情緒指標，用 0~100 的分數做代表，愈接近 0 代表市場愈恐懼，此時買入勝率愈高；愈接近 100 代表市場愈貪婪，不應繼續追高。相較於 CNN 恐懼貪婪指數納入更全面的指標，包含俗稱「美國散戶指標」的 AAII 投資人調查結果，更能準確反映長線市場情緒與價格的關係。'}, {'title': '歷史數據回顧', 'content': '回顧歷史，Sentiment Inside Out 恐懼貪婪指標 (簡稱:SIO恐懼貪婪指標)過往每次達到 10 分附近時為熊市底部(包含 2009 年金融海嘯、2020 年新冠疫情、2022 年俄烏戰爭)，若能把握都是極佳的買點。'}]";
"marketSentiment.descriptions.aaiiSpread.shortDescription" = "AAII 投資人情緒調查每週詢問會員對未來六個月市場走勢的看法（看漲、看跌、中立）。看漲比例減去看跌比例（Bull-Bear Spread）是衡量散戶情緒的常用指標。";
"marketSentiment.descriptions.aaiiSpread.sections" = "[{'title': '指標解讀', 'content': '極高的 Bull-Bear Spread（遠高於歷史平均）通常表示市場過度樂觀，可能是潛在的賣出信號。反之，極低的 Spread（遠低於歷史平均，甚至為負值）表示市場過度悲觀，可能是潛在的買入機會。'}, {'title': '注意事項', 'content': '此指標反映的是散戶情緒，而散戶情緒往往被視為反向指標。專業投資者可能會利用散戶的極端情緒進行反向操作。'}]";
"marketSentiment.descriptions.cboeRatio.shortDescription" = "CBOE 買/賣權比例（Put/Call Ratio）是衡量市場投機情緒的重要指標。它計算的是交易所交易的賣權（Put）合約數量與買權（Call）合約數量的比率。";
"marketSentiment.descriptions.cboeRatio.sections" = "[{'title': '指標解讀', 'content': '高 Put/Call Ratio（通常大於 1）表示投資者購買了更多的賣權進行避險或看空，市場情緒偏向恐懼。低 Put/Call Ratio（通常小於 0.7）表示投資者購買了更多的買權進行投機或看多，市場情緒偏向貪婪。使用 5 日平均值可以平滑數據，更好地觀察趨勢。'}, {'title': '反向指標特性', 'content': '與 AAII 調查類似，極端高的 Put/Call Ratio 常出現在市場底部，而極端低的比率常出現在市場頂部，具有反向指標的特性。'}]";
"marketSentiment.descriptions.marketMomentum.shortDescription" = "市場動能指標衡量 S&P 500 指數相對於其 125 日移動平均線（約半年線）的位置。它反映了市場的中期趨勢強度。";
"marketSentiment.descriptions.marketMomentum.sections" = "[{'title': '指標解讀', 'content': '當 S&P 500 指數遠高於其 125 日均線時，表示市場處於強勁的上升趨勢，動能強，市場情緒偏向貪婪。當指數遠低於均線時，表示市場處於下降趨勢，動能弱，市場情緒偏向恐懼。'}, {'title': '結合其他指標', 'content': '市場動能是趨勢跟隨指標，可以與其他反向指標（如 Put/Call Ratio）結合使用，以更全面地評估市場狀態。'}]";
"marketSentiment.descriptions.vixMA50.shortDescription" = "VIX 指數（波動率指數），常被稱為「恐慌指數」，衡量市場對未來 30 天 S&P 500 指數波動性的預期。此處計算 VIX  50 日移動平均線來觀察恐慌情緒的長期變化趨勢。";
"marketSentiment.descriptions.vixMA50.sections" = "[{'title': '指標解讀', 'content': '當 VIX 50 日移動平均線上升，表示市場恐慌情緒上升，避險需求增加。當 VIX 50 日移動平均線下降時，表示市場相對平靜，投資者風險偏好升高，市場情緒偏向貪婪。'}, {'title': '極端值意義', 'content': 'VIX 的極端飆升通常伴隨著市場的大幅下跌，被視為買入機會的信號之一。持續處於低位的 VIX 則是預示著貪婪情緒，需要警惕。'}]";
"marketSentiment.descriptions.safeHaven.shortDescription" = "避險需求指標比較過去 20 個交易日中，股票（風險資產）的總回報與美國公債（避險資產）的總回報兩者之間的差異。它反映了資金流向避險資產的程度。";
"marketSentiment.descriptions.safeHaven.sections" = "[{'title': '指標解讀', 'content': '當公債回報顯著優於股票回報時（指標數值低），表示投資者紛紛湧入避險資產，市場情緒偏向恐懼。當股票回報顯著優於公債回報時（指標數值高），表示投資者風險偏好高，資金流向風險資產，市場情緒偏向貪婪。'}, {'title': '資金流向觀察', 'content': '這個指標提供了觀察市場整體風險偏好變化的窗口，是判斷市場情緒的重要參考。'}]";
"marketSentiment.descriptions.junkBond.shortDescription" = "垃圾債券（高收益債券）與投資級公司債券之間的殖利率差（Spread）反映了市場對信用風險的態度。垃圾債券風險較高，其殖利率通常也較高。";
"marketSentiment.descriptions.junkBond.sections" = "[{'title': '指標解讀', 'content': '當利差擴大（指標值高）時，表示投資者要求更高的風險補償才願意持有垃圾債券，這通常發生在市場擔憂經濟前景或流動性收緊時，市場情緒偏向恐懼。當利差縮小（指標值低）時，表示投資者對風險容忍度提高，願意接受較低的風險補償，市場情緒偏向貪婪。'}, {'title': '信用市場信號', 'content': '垃圾債利差是觀察信用市場健康狀況和整體市場風險偏好的重要領先指標之一。'}]";
"marketSentiment.descriptions.cotIndex.shortDescription" = "COT 指數（Commitments of Traders Index）基於美國商品期貨交易委員會（CFTC）每週公佈的持倉報告，衡量大型投機者（通常被認為是掌握更多資訊的交易者）在 S&P 500 期貨市場的淨持倉（多單減空單）相對於歷史水平的位置。";
"marketSentiment.descriptions.cotIndex.sections" = "[{'title': '指標解讀', 'content': 'COT 指數接近 100% 表示大型投機者的淨多單處於歷史極高水平，市場可能過度看多，情緒偏向極度貪婪。指數接近 0% 表示淨空單處於歷史極高水平（或淨多單極低），市場可能過度看空，情緒偏向極度恐懼。'}, {'title': '聰明錢動向', 'content': '追蹤大型投機者的持倉變化，有助於了解所謂「聰明錢」對市場未來走向的看法。'}]";
"marketSentiment.descriptions.naaimIndex.shortDescription" = "NAAIM 曝險指數（National Association of Active Investment Managers Exposure Index）每週調查其會員（主動型投資經理人）當前的股票市場曝險水平（0% 表示完全沒有持股，100% 表示完全持股，可超過 100% 表示使用槓桿）。";
"marketSentiment.descriptions.naaimIndex.sections" = "[{'title': '指標解讀', 'content': '極高的曝險指數（如接近或超過 100%）表示基金經理人普遍看好市場並積極持有股票，市場情緒偏向貪婪。極低的曝險指數（如接近 0% 或為負值，表示持有空頭倉位）表示經理人普遍看空市場並減持股票，市場情緒偏向恐懼。'}, {'title': '機構法人情緒', 'content': '此指標反映了專業投資機構的情緒和倉位調整，是觀察市場主流看法的重要參考。'}]";
