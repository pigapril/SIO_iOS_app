"priceAnalysis.explanation.mainTitle" = "What is the LOHAS Five-Line Analysis?";
"priceAnalysis.explanation.shortDescription" = "Analyze whether the current stock price is overly optimistic or pessimistic. Utilize the statistical properties of stock price mean reversion to track long-term trends and determine the price's position.";
"priceAnalysis.explanation.readMorePrefix" = "For detailed instructions, please see the article:";
"priceAnalysis.explanation.readMoreLinkText" = "Analyze Price Trends and Sentiment with LOHAS Five-Line Analysis";
"priceAnalysis.explanation.sd.title" = "LOHAS Five-Line Analysis";
"priceAnalysis.explanation.sd.l1" = "The middle trend line is a long-term moving average, serving as the baseline for assessing the long-term price trend. Two standard deviations are added above and below this baseline.";
"priceAnalysis.explanation.sd.l2" = "The further the price moves from the middle trend line, the further it deviates from the long-term average, increasing the probability of reverting to the trend line.";
"priceAnalysis.explanation.sd.l3" = "When the price touches the uppermost band, it indicates a strong short-term overbought condition and extreme market optimism, posing a risk of pullback.";
"priceAnalysis.explanation.sd.l4" = "When the price touches the lowermost band, it indicates a strong short-term oversold condition and extreme market pessimism, presenting an opportunity for a rebound.";
"priceAnalysis.explanation.ulBand.title" = "LOHAS Channel";
"priceAnalysis.explanation.ulBand.l1" = "The LOHAS Channel is a more sensitive indicator used to help determine short-term overbought and oversold conditions.";
"priceAnalysis.explanation.ulBand.l2" = "When the price breaks above the upper LOHAS Channel, it may indicate short-term overheating.";
"priceAnalysis.explanation.ulBand.l3" = "When the price breaks below the lower LOHAS Channel, it may indicate short-term cooling.";
"priceAnalysis.explanation.combined.title" = "Using Both Together";
"priceAnalysis.explanation.combined.l1" = "When the price touches the uppermost or lowermost band of the LOHAS Five-Line Analysis and simultaneously breaks the LOHAS Channel, it might signify a continuation of the trend. Consider waiting for the price to return within the LOHAS Channel before taking action.";
"priceAnalysis.explanation.combined.l2" = "It is recommended for use with index ETFs or large-cap stocks with clear trends, in conjunction with fundamental analysis. It should not be used as the sole basis for buy/sell decisions.";
